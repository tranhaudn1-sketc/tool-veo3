# Google Gemini / Veo / Imagen API Key (lấy từ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mật khẩu duy nhất để đăng nhập web app cá nhân
APP_PASSWORD=your_secure_password_here

# Chuỗi bí mật ký cookie phiên đăng nhập (tối thiểu 32 ký tự)
SESSION_SECRET=super_secret_session_key_random_change_this_value_in_production_32chars

# Đường dẫn cơ sở dữ liệu SQLite
DATABASE_URL="file:./dev.db"

# Đường dẫn lưu trữ file cục bộ (ảnh, video, thumbnail)
STORAGE_DIR="./storage"

# Cổng chạy ứng dụng
PORT=3000
